# AtHome Japan Agent Harness - environment template
#
# Copy this file to `.env` (git-ignored) and fill in real values. The keys below
# are the exact set the config parser accepts. Keep this file in sync with
# `src/athome_harness/config.py`; an unknown ATHOME_-prefixed key raises at startup.

# --- Credentials (never commit real values) ---

# OpenRouter API key. Required; the harness will not start without it.
OPENROUTER_API_KEY=

# Webshare rotating proxy credentials. Optional; proxies engage only on an IP block.
WEBSHARE_PROXY_USER=
WEBSHARE_PROXY_PASS=

# --- Model selection ---

# General-purpose LLM used for planning and shortlisting.
ATHOME_GENERAL_MODEL=deepseek/deepseek-v4-flash-0731

# Vision-capable LLM used for optional floor-plan evaluation (off by default).
ATHOME_VISION_MODEL=google/gemma-4-31b-it

# --- Budgets and limits (defaults from SPEC.md section 5) ---

# Polite rate limiting: how many requests per base interval, and max random jitter.
ATHOME_RATE_REQUESTS=1
ATHOME_RATE_INTERVAL_S=2.0
ATHOME_RATE_JITTER_MAX_S=1.0

# Results per AtHome page (VERIFIED value is 30).
ATHOME_RESULTS_PER_PAGE=30

# LLM funnel thresholds.
ATHOME_SHORTLIST_SIZE=20
ATHOME_RECOMMENDATIONS_COUNT=5

# Hard ceilings for a single live search.
ATHOME_MAX_PAGES=100
ATHOME_RUNTIME_MINUTES=30

# Network and fault tolerance.
ATHOME_HTTP_TIMEOUT_S=30.0
ATHOME_PROXY_RETRIES=3

# Prefetch cache freshness (post-MVP feature gate).
ATHOME_PREFETCH_TTL_HOURS=48.0

# Determinism: LLM scoring temperature is 0.
ATHOME_LLM_TEMPERATURE=0.0